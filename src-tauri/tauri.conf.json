{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroPulse Swarm",
  "version": "0.1.0",
  "identifier": "com.zeropulse.swarm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZeroPulse Swarm",
        "width": 1480,
        "height": 940,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#030816"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
